# OpenClaw environment variables
# Copy to .env and set values. OpenClaw loads .env at startup from (in order):
#   1) OPENCLAW_DOTENV_PATH if set (path to a .env file)
#   2) current working directory .env
#   3) ~/.openclaw/.env (or OPENCLAW_STATE_DIR/.env), without overriding.
# Do not commit .env; it is in .gitignore.

# Optional: override config/state directory (default: ~/.openclaw)
# OPENCLAW_HOME=
# OPENCLAW_STATE_DIR=

# Gateway auth (for local gateway and pairing)
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=

# CLI profile (e.g. --profile myprofile loads OPENCLAW_PROFILE=myprofile)
# OPENCLAW_PROFILE=

# TUI theme: dark, light, or auto
# OPENCLAW_THEME=

# TTS prefs JSON path (optional)
# OPENCLAW_TTS_PREFS=

# Provider API keys (also configurable in config env / config file)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=

# Langfuse (optional: LLM observability; set LANGFUSE_SECRET_KEY to enable)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
